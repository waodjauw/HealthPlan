# ===== 后端运行环境变量 =====
# 复制为 .env 后填写真实值

# 服务端口
PORT=3000

# CORS 允许的源（逗号分隔）。Web 与安卓调试地址都要放进来。
# 例：http://localhost:5173,http://192.168.x.x:5173,capacitor://localhost
CORS_ORIGIN=http://localhost:5173,http://localhost:19006

# JWT 密钥，生产环境务必改成随机长字符串
JWT_SECRET=change-me-to-a-long-random-secret

# 数据库连接（Neon 免费 Postgres）。格式：
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/healthplan?sslmode=require
